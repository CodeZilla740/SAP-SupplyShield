# SupplyShield environment template — copy to server/.env and fill in what you have.
# Every value is optional: without them the app runs on the local SQLite
# fallback with the deterministic template explainer, all clearly labelled.

# ---- Server ----
PORT=4004
# DEFAULT_PLANNER=Arjun Kumar

# ---- SAP HANA Cloud (primary database) ----
# Provide these to switch persistence from SQLite to SAP HANA Cloud.
# On SAP BTP Cloud Foundry the same values are read automatically from
# VCAP_SERVICES when an SAP HANA Cloud instance is bound (see deployment/).
HANA_HOST=
HANA_PORT=443
HANA_USER=
HANA_PASSWORD=
HANA_SCHEMA=SUPPLYSHIELD
HANA_ENCRYPT=true

# ---- Local fallback database ----
# SQLITE_FILE=./data/supplyshield-demo.db

# ---- SAP Generative AI Hub (orchestration service in SAP AI Core) ----
# Paste the full service-key JSON (single line) for the Orchestration service.
# Without it, explanations are generated by a deterministic rule-based
# template and labelled "Rule-based template (SAP Generative AI Hub not configured)".
AICORE_SERVICE_KEY=
LLM_MODEL=gpt-4o
AICORE_RESOURCE_GROUP=default

# ---- Weather disruption feed ----
# Open-Meteo requires no API key. Weather alerts are advisory only and are
# marked UNVERIFIED — a weather alert is never treated as proof a port is closed.
WEATHER_PROVIDER=open-meteo
# WEATHER_PROVIDER=off
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_MS=6000

# ---- SAP S/4HANA (read-only purchase-order verification) ----
# Leave empty to use the MOCK adapter backed by HANA tables (EBELN-shaped).
# Live mode is READ-ONLY: the app never posts inventory or logistics
# transactions to S/4HANA. Approved plans are recorded as SIMULATED EXECUTION.
S4HANA_BASE_URL=
S4HANA_API_KEY=


# ---- UI dev proxy (only needed for `npm run dev` in ui/) ----
# API_PROXY_TARGET=http://localhost:4004
